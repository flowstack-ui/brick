{
  "$schema": "flowstack.theme-manifest.v1",
  "activation": {
    "appearanceAttribute": "data-brick-appearance",
    "cssLayer": "flowstack.theme",
    "themeAttribute": "data-flowstack-theme"
  },
  "appearances": {
    "default": "system",
    "supported": [
      "light",
      "dark"
    ]
  },
  "artifacts": {
    "css": "theme.css",
    "manifest": "theme.manifest.json",
    "report": "theme.report.json",
    "tokens": "theme.tokens.json"
  },
  "brickContract": {
    "package": {
      "name": "@flowstack-ui/brick",
      "version": "0.2.3"
    },
    "schema": "flowstack.brick-theme-contract.v1",
    "version": 5
  },
  "compatibility": {
    "brick": "^0.2.0"
  },
  "extensionNamespaces": [
    "flowstack.dev/qualification"
  ],
  "guidance": {
    "purpose": "Qualification only; not a reusable product theme.",
    "review": [
      "Accent controls must be teal rather than Brick purple.",
      "Focus rings must be orange in both appearances.",
      "Project promotion and analytics roles remain outside Brick vocabulary."
    ]
  },
  "requirements": {
    "fonts": [
      {
        "family": "system-ui",
        "source": "application"
      }
    ]
  },
  "theme": {
    "description": "High-contrast teal and orange instrument theme for Brick browser qualification.",
    "id": "qualification",
    "name": "Theme Qualification"
  }
}
