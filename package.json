  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-styles.mjs --mode production",
    "build:css:dev": "node scripts/build-styles.mjs --mode development",
    "build:playground": "npm run build && npm run build:playground:built",
    "build:playground:built": "vite build --config playground/vite.config.ts",
    "build:consumer": "npm run build && npm run build:consumer:built",
    "build:consumer:built": "npm run build -w apps/consumer",
    "dev": "npm run dev:playground",
    "dev:playground": "npm run build && vite --config playground/vite.config.ts",
    "dev:playground:network": "npm run build && vite --config playground/vite.config.ts --host 0.0.0.0",
    "dev:consumer": "npm run build && npm run dev -w apps/consumer",
    "dev:consumer:network": "npm run build && npm run dev:network -w apps/consumer",
    "dev:test": "vitest",
    "docs:component": "node scripts/verify-component-docs.mjs",
    "docs:component:semantic": "node scripts/verify-component-documentation-contracts.mjs",
    "preview:playground": "vite preview --config playground/vite.config.ts",
    "typecheck": "npm run build && npm run typecheck:built",
    "typecheck:built": "tsc -p tsconfig.tools.json && tsc -p test/types/tsconfig.json && tsc -p playground/tsconfig.json",
    "test": "npm run test:node && npm run test:components && npm run test:css",
    "test:node": "npm run build && npm run test:node:built",
    "test:node:built": "node --test test/package/*.test.mjs",
    "test:components": "vitest run --coverage",
    "test:component": "node scripts/test-component.mjs all",
    "test:component:unit": "node scripts/test-component.mjs unit",
    "test:component:types": "node scripts/test-component.mjs types",
    "test:component:browser": "node scripts/test-component.mjs browser",
    "test:component:visual": "node scripts/test-component.mjs visual",
    "test:ownership": "node scripts/verify-component-tests.mjs",
    "test:integration": "vitest run test/integration --coverage=false && npm run build:playground && playwright test playground/tests/integration --project=chromium",
    "test:css": "node scripts/prototype-css.mjs",
    "test:browser": "npm run build:playground && playwright test --project=chromium",
    "test:browser:release": "npm run build:playground && npm run test:browser:release:built",
    "test:browser:release:built": "playwright test",
    "test:consumer": "npm run build && npm test -w apps/consumer",
    "test:visual": "npm run build:playground && playwright test playground/tests/components/*/visual.spec.ts --project=chromium",
    "test:visual:update": "npm run build:playground && playwright test playground/tests/components/*/visual.spec.ts --project=chromium --update-snapshots",
    "test:all": "npm run check:release",
    "size:css": "node scripts/report-css-size.mjs",
    "pack:check": "node scripts/verify-package.mjs --dry-run",
    "verify:consumers": "npm run build && npm run verify:consumers:built",
    "verify:consumers:built": "node scripts/verify-consumers.mjs",
    "verify:consumer": "npm run build && npm run verify:consumer:built",
    "verify:consumer:built": "node scripts/verify-app-consumer.mjs",
    "verify:typography": "node scripts/verify-typography.mjs",
    "verify:playground-primitives": "node scripts/verify-playground-primitives.mjs",
    "verify:playground-stack": "node scripts/verify-playground-stack.mjs",
    "verify:playground-grid": "node scripts/verify-playground-grid.mjs",
    "verify:playground-container": "node scripts/verify-playground-container.mjs",
    "verify:playground-surface": "node scripts/verify-playground-surface.mjs",
    "verify:playground-divider": "node scripts/verify-playground-divider.mjs",
    "verify:playground-scroll-area": "node scripts/verify-playground-scroll-area.mjs",
    "verify:playground-code": "node scripts/verify-playground-code.mjs",
    "verify:playground-nav-list": "node scripts/verify-playground-nav-list.mjs",
    "verify:playground-sidebar": "node scripts/verify-playground-sidebar.mjs",
    "verify:playground-icon": "node scripts/verify-playground-icon.mjs",
    "verify:playground-image": "node scripts/verify-playground-image.mjs",
    "verify:playground-list": "node scripts/verify-playground-list.mjs",
    "verify:playground-composition": "node scripts/verify-playground-composition.mjs",
    "check": "npm run check:repository",
    "check:repository": "npm run test:ownership && npm run docs:component && npm run docs:component:semantic && npm run verify:typography && npm run verify:playground-primitives && npm run verify:playground-stack && npm run verify:playground-grid && npm run verify:playground-container && npm run verify:playground-surface && npm run verify:playground-divider && npm run verify:playground-scroll-area && npm run verify:playground-code && npm run verify:playground-nav-list && npm run verify:playground-sidebar && npm run verify:playground-icon && npm run verify:playground-image && npm run verify:playground-list && npm run verify:playground-composition && npm run build && npm run typecheck:built && npm run test:node:built && npm run test:components && npm run test:css && npm run build:playground:built && npm run build:consumer:built && npm run pack:check && npm run verify:consumers:built",
    "check:release": "npm run check:repository && npm run test:browser:release:built && npm run verify:consumer:built && npm run size:css",
    "prepublishOnly": "npm run build"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "not IE 11"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "glob": "13.0.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@flowstack-ui/atom": "0.20.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "browserslist": "^4.28.6",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.32.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
