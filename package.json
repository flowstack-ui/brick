  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs --package-only && npm run build:js && npm run build:css && npm run build:theme-contract && npm run agents:build",
    "agents:build": "node scripts/build-agent-knowledge.mjs",
    "agents:check": "node scripts/build-agent-knowledge.mjs --check",
    "build:js": "node scripts/generate-aspect-ratios.mjs --check && tsc -p tsconfig.build.json",
    "build:css": "node scripts/generate-pin-input-variant-css.mjs --check && node scripts/generate-chip-recipes.mjs --check && node scripts/generate-disclosure-recipes.mjs --check && node scripts/generate-tags-input-variant-css.mjs --check && node scripts/generate-textarea-variant-css.mjs --check && node scripts/generate-color-picker-size-css.mjs --check && node scripts/generate-action-size-css.mjs --check && node scripts/generate-form-control-size-css.mjs --check && node scripts/build-styles.mjs --mode production",
    "build:css:dev": "node scripts/generate-pin-input-variant-css.mjs --check && node scripts/generate-chip-recipes.mjs --check && node scripts/generate-disclosure-recipes.mjs --check && node scripts/generate-tags-input-variant-css.mjs --check && node scripts/generate-textarea-variant-css.mjs --check && node scripts/generate-color-picker-size-css.mjs --check && node scripts/generate-action-size-css.mjs --check && node scripts/generate-form-control-size-css.mjs --check && node scripts/build-styles.mjs --mode development",
    "generate:action-sizes": "node scripts/generate-action-size-css.mjs",
    "generate:action-sizes:check": "node scripts/generate-action-size-css.mjs --check",
    "generate:form-control-sizes": "node scripts/generate-form-control-size-css.mjs",
    "generate:form-control-sizes:check": "node scripts/generate-form-control-size-css.mjs --check",
    "build:theme-contract": "node scripts/build-theme-contract.mjs",
    "build:playground": "npm run build && npm run build:playground:built",
    "build:playground:built": "node scripts/verify-preview-environment.mjs && vite build --config playground/vite.config.ts",
    "build:consumer": "npm run build && npm run build:consumer:built",
    "build:consumer:built": "npm run build -w apps/consumer",
    "dev": "npm run dev:playground",
    "dev:playground": "npm run build && vite --config playground/vite.config.ts",
    "dev:playground:network": "npm run build && vite --config playground/vite.config.ts --host 0.0.0.0",
    "dev:consumer": "npm run build && npm run dev -w apps/consumer",
    "dev:consumer:network": "npm run build && npm run dev:network -w apps/consumer",
    "dev:test": "vitest",
    "docs:component": "node scripts/verify-component-docs.mjs",
    "docs:component:semantic": "node scripts/verify-component-documentation-contracts.mjs",
    "preview:playground": "vite preview --config playground/vite.config.ts",
    "typecheck": "npm run build && npm run typecheck:built",
    "typecheck:built": "tsc -p tsconfig.tools.json && tsc -p test/types/tsconfig.json && tsc -p playground/tsconfig.json",
    "test": "npm run test:node && npm run test:components && npm run test:css",
    "test:node": "npm run build && npm run test:node:built",
    "test:node:built": "node --test test/package/*.test.mjs",
    "test:components": "vitest run --coverage",
    "test:component": "node scripts/test-component.mjs all",
    "test:component:unit": "node scripts/test-component.mjs unit",
    "test:component:types": "node scripts/test-component.mjs types",
    "test:component:browser": "node scripts/test-component.mjs browser",
    "test:component:visual": "node scripts/test-component.mjs visual",
    "test:ownership": "node scripts/verify-component-tests.mjs",
    "test:integration": "vitest run test/integration --coverage=false && npm run build:playground && npm run test:processes && playwright test playground/tests/integration --project=chromium",
    "test:css": "node scripts/prototype-css.mjs",
    "test:surface-effects": "node scripts/verify-surface-effects-browser.mjs",
    "test:browser": "npm run build:playground && npm run test:browser:project:built -- chromium",
    "test:browser:project:built": "npm run test:processes && node scripts/run-browser-project.mjs",
    "test:browser:release": "npm run build:playground && npm run test:browser:release:built",
    "test:browser:release:built": "npm run test:processes && node scripts/run-release-browser-tests.mjs",
    "test:browser:release:project:built": "npm run test:processes && node scripts/run-release-browser-tests.mjs",
    "test:consumer": "npm run build && npm test -w apps/consumer",
    "test:visual": "npm run build:playground && npm run test:processes && node scripts/run-browser-project.mjs chromium --visual",
    "test:visual:update": "npm run build:playground && npm run test:processes && node scripts/run-browser-project.mjs chromium --visual --update-snapshots",
    "test:all": "npm run check:release",
    "size:css": "node scripts/report-css-size.mjs",
    "pack:check": "node scripts/verify-package.mjs --dry-run",
    "pack:check:archive": "node scripts/verify-package.mjs --tarball",
    "verify:consumers": "npm run build && npm run verify:consumers:built",
    "verify:consumers:built": "node scripts/verify-consumers.mjs",
    "verify:consumers:archive": "node scripts/verify-consumers.mjs --tarball",
    "verify:consumer": "npm run build && npm run verify:consumer:built",
    "verify:consumer:built": "node scripts/verify-app-consumer.mjs",
